{
  "version": 1,
  "fileEntries": ["config.yaml", "litellm-config.yaml", ".env", ".env.*"],
  "core": [
    ".cache",
    ".git",
    ".venv-litellm",
    "config.yaml",
    "data",
    "desktop",
    "dist",
    "dist-desktop",
    "docs",
    "installer",
    "litellm-config.yaml",
    "outputs",
    "python-runtime",
    "scripts",
    "storage"
  ],
  "consumers": {
    "nextStandaloneExcludes": {
      "extra": [".env", ".env.*"]
    }
  }
}