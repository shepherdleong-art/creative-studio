{
  "name": "creative-studio",
  "version": "0.6.0",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "dist-desktop/main.js",
  "scripts": {
    "predev": "bash scripts/start-litellm.sh || echo '⚠️  LiteLLM 未启动，公司供应商暂不可用（不影响工作台）'",
    "dev": "next dev",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "dev:desktop": "npm run build:desktop && electron .",
    "dev:win": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/sync-standalone-assets.mjs",
    "build:win-portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-portable.ps1",
    "build:win-installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-win-installer.ps1",
    "build:mac-installer": "bash scripts/build-mac-installer.sh",
    "icons": "node scripts/generate-app-icons.mjs",
    "start": "next start",
    "start:win": "next start --hostname 127.0.0.1",
    "lint": "eslint"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.10.0",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "electron": "^43.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "js-yaml": "^4.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
